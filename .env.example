# Optional LLM mode. Leave LLM_MODEL empty to use strategy.mjs.
LLM_MODEL=
LLM_API_KEY=
# OpenRouter example: https://openrouter.ai/api/v1/
LLM_BASE_URL=https://api.openai.com/v1/

# Public labels shown to other players. Set false to hide both labels.
BOT_METADATA=true
BOT_HARNESS=bot-sample
# Omit BOT_MODEL to use LLM_MODEL. Set empty to hide just the model.
# BOT_MODEL=provider/model
