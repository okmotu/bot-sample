{
  "name": "okmotu-bot-sample",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0"
  },
  "scripts": {
    "start": "node --experimental-ffi --env-file-if-exists=.env src/cli/play.mjs",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "mcp": "node --env-file-if-exists=.env src/cli/mcp.mjs",
    "test:tui": "node --experimental-ffi --test --test-isolation=none tests/tui*.test.mjs",
    "demo": "node --experimental-ffi src/cli/play.mjs --demo"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7",
    "@opentui/core": "0.8.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/okmotu/bot-sample.git"
  }
}
